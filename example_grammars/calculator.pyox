# Example grammar for mathematical expressions without parenthesis

version 1.0.0

section IMPORTS:

from math import pow as power

section LEXER:

# regex | token type ('_' for ignored symbols) | callable converter of lexeme to value

/\+/                  plus
/\-/                  minus
/\*/                  times
/\//                  divide
/\^/                  exp
/(-?[1-9][0-9]*)|0/   num       lambda x: int(x)      # todo in the future imports shall be usable here too
/\s/                  _


section PARSER:
@traversal ast postorder
START: EXPR                     => $0.value, $0.final = ($1.value, $1.value) && @ast print($0.final)
     ;

# Lowest precedence (+, -)
EXPR: EXPR plus TERM            => $0.value = $1.value + $3.value
    | EXPR minus TERM           => $0.value = $1.value - $3.value
    | TERM                      => $0.value = $1.value
    ;

# Medium precedence (*, /)
TERM: TERM times EXPONENT       => $0.value = $1.value * $3.value
    | TERM divide EXPONENT      => $0.value = $1.value / $3.value
    | EXPONENT                  => $0.value = $1.value
    ;

# High precedence (^)
EXPONENT: NUM exp EXPONENT      => $0.value = power($1.value, $3.value)
    | NUM                       => $0.value = $1.value
    ;

# Highest precedence (atoms)
NUM: num                        => $0.value = $1.value
    ;